# ─────────────────────────────────────────────────────────────────────────────
# Verdant environment configuration. Copy to .env.local (dev) and fill in.
# Placeholders only — NEVER commit real values. Never use NEXT_PUBLIC_ for secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core (required) ──────────────────────────────────────────────────────────
NODE_ENV=development
# Public base URL of the web app. Used for OAuth callbacks and signed media URLs.
# Instagram must reach media from the internet: use your public HTTPS domain (or a tunnel) for it.
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://verdant:verdant@localhost:5432/verdant
# Connections per process (default 10). Use 1 with the local PGlite database (pnpm db:local).
DATABASE_POOL_SIZE=
# Required by the worker (BullMQ) and for shared rate limiting.
REDIS_URL=redis://localhost:6379
# 32+ random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Exactly 32 bytes, base64 or hex. Encrypts OAuth tokens (AES-256-GCM).
ENCRYPTION_KEY=
# During key rotation, put the old key here so existing tokens still decrypt.
ENCRYPTION_KEY_PREVIOUS=
LOG_LEVEL=info
# Shown on /terms and /privacy (also used in platform app-review submissions)
LEGAL_ENTITY_NAME=Verdant
SUPPORT_EMAIL=
LEGAL_JURISDICTION=
# Login created by `pnpm db:seed` (set real values only in .env.local, never commit them)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
# Comma-separated emails allowed to open /admin.
ADMIN_EMAILS=

# ── Sign-in (optional) ───────────────────────────────────────────────────────
# Google OAuth client (Authorized redirect URI: {APP_BASE_URL}/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Transactional email via Resend. Without it, dev logs links to the console; production refuses to send.
RESEND_API_KEY=
EMAIL_FROM="Verdant <no-reply@yourdomain.com>"
REQUIRE_EMAIL_VERIFICATION=false

# ── AI providers ─────────────────────────────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional per-task model overrides, format provider:model.
# Defaults (verified 2026-10-26): draft/adapt=groq:openai/gpt-oss-120b, rewrite/hashtags=groq:openai/gpt-oss-20b,
# extract/critique/voice=gemini:gemini-3.8-flash
AI_MODEL_DRAFT=
AI_MODEL_ADAPT=
AI_MODEL_REWRITE=
AI_MODEL_HASHTAGS=
AI_MODEL_EXTRACT=
AI_MODEL_CRITIQUE=
AI_MODEL_VOICE=
# Comment replies (inbox + autopilot). Default groq:openai/gpt-oss-120b
AI_MODEL_REPLY=
# Image generation (studio image prompter). Default gemini:gemini-3.1-flash-image (needs GEMINI_API_KEY)
AI_MODEL_IMAGE=
# Optional fallback for text-only tasks (never used for documents), e.g. gemini:gemini-3.6-flash
AI_MODEL_FALLBACK=
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2

# ── LinkedIn (Share on LinkedIn + Sign In with LinkedIn using OpenID Connect) ─
# Redirect URL: {APP_BASE_URL}/api/v1/social-accounts/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# YYYYMM; each version is supported ≥ 1 year. Update when LinkedIn sunsets it.
LINKEDIN_API_VERSION=202610
# Requires Community Management API approval.
LINKEDIN_ENABLE_ORGANIZATIONS=false

# ── Instagram (Instagram API with Instagram Login; professional accounts) ────
# Redirect URL: {APP_BASE_URL}/api/v1/social-accounts/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v26.0
# Ask for comments/insights permissions (they must be enabled on your Meta app or login fails)
INSTAGRAM_REQUEST_COMMENTS=true
INSTAGRAM_REQUEST_INSIGHTS=true
# Meta callbacks to register on the Instagram app:
#   Deauthorize:   {APP_BASE_URL}/api/webhooks/meta/deauthorize
#   Data deletion: {APP_BASE_URL}/api/webhooks/meta/data-deletion

# ── Facebook Pages (Facebook Login) ──────────────────────────────────────────
# Valid OAuth redirect URI: {APP_BASE_URL}/api/v1/social-accounts/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v26.0

# ── Threads ──────────────────────────────────────────────────────────────────
# Redirect callback URL: {APP_BASE_URL}/api/v1/social-accounts/threads/callback
THREADS_APP_ID=
THREADS_APP_SECRET=

# ── YouTube (Google OAuth; falls back to GOOGLE_CLIENT_ID/SECRET) ───────────
# Authorized redirect URI: {APP_BASE_URL}/api/v1/social-accounts/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ── TikTok (Login Kit + Content Posting API) ─────────────────────────────────
# Redirect URI: {APP_BASE_URL}/api/v1/social-accounts/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Pinterest ────────────────────────────────────────────────────────────────
# Redirect URI: {APP_BASE_URL}/api/v1/social-accounts/pinterest/callback
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# ── Reddit (requires Reddit API approval) ────────────────────────────────────
# Redirect URI: {APP_BASE_URL}/api/v1/social-accounts/reddit/callback
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Your Reddit username, used in the required User-Agent
REDDIT_USERNAME=

# Bluesky, Mastodon, Telegram, Discord, WordPress and custom webhooks need no server
# credentials: users connect them in the app with their own app password, token or URL.

# ── X (OAuth 2.0 with PKCE, confidential client) ─────────────────────────────
# Callback URI: {APP_BASE_URL}/api/v1/social-accounts/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
X_MAX_POST_LENGTH=280
# X bills each read; enable metrics collection deliberately.
ANALYTICS_X_ENABLED=false
# Reading X replies/mentions for the inbox is billed per post read
ENGAGEMENT_X_ENABLED=false
# How often each account is checked for new comments, in minutes
ENGAGEMENT_SYNC_MINUTES=15

# ── Storage ──────────────────────────────────────────────────────────────────
# local = files under STORAGE_LOCAL_DIR (dev / single server). s3 = any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ── Limits & retention ───────────────────────────────────────────────────────
MEDIA_MAX_IMAGE_MB=8
MEDIA_MAX_VIDEO_MB=200
DOCUMENT_MAX_MB=15
DOCUMENT_RETENTION_DAYS=30
DEFAULT_PLAN=free
