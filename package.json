{
  "name": "verdant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --conditions=react-server --env-file-if-exists=.env.local --env-file-if-exists=.env worker/index.ts",
    "worker:watch": "tsx watch --conditions=react-server --env-file-if-exists=.env.local --env-file-if-exists=.env worker/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env src/server/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "worker:prod": "tsx --conditions=react-server worker/index.ts",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env.local --env-file-if-exists=.env src/server/db/seed.ts",
    "db:local": "node scripts/local-db.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@google/genai": "^2.31.0",
    "better-auth": "^1.7.13",
    "bullmq": "5.81.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.4",
    "file-type": "^22.2.0",
    "groq-sdk": "^1.6.0",
    "ioredis": "5.11.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@electric-sql/pglite-socket": "0.2.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "pino-pretty": "^13.2.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "msgpackr-extract",
      "unrs-resolver",
      "protobufjs",
      "@google/genai"
    ]
  }
}
